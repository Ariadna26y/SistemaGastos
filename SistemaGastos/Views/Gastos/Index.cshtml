@model List<SistemaGastos.Models.Gasto>

@{
    ViewData["Title"] = "Mis Gastos";
    var iconos = new Dictionary<string, string>
    {
        {"comida", "bi-egg-fried"}, {"transporte", "bi-car-front"},
        {"entretenimiento", "bi-controller"}, {"salud", "bi-heart-pulse"},
        {"educacion", "bi-book"}, {"servicios", "bi-lightbulb"},
        {"ropa", "bi-bag"}, {"otros", "bi-box"},
        {"trabajo", "bi-briefcase"}, {"belleza", "bi-stars"}
    };
    var colores = new Dictionary<string, string>
    {
        {"comida", "#ff6b6b"}, {"transporte", "#4facfe"},
        {"entretenimiento", "#a29bfe"}, {"salud", "#55efc4"},
        {"educacion", "#fdcb6e"}, {"servicios", "#00cec9"},
        {"ropa", "#fd79a8"}, {"otros", "#b2bec3"},
        {"trabajo", "#6c5ce7"}, {"belleza", "#e84393"}
    };
}

<div class="container mt-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-list-ul me-2"></i>Mis Gastos</h2>
        <a asp-action="Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Agregar
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-5 text-center">
            <i class="bi bi-inbox" style="font-size: 3rem; color: #d1d5db;"></i>
            <p class="mt-3 text-muted">No hay gastos registrados aún.</p>
            <a asp-action="Crear" class="btn btn-primary mx-auto" style="width: fit-content;">
                + Agregar tu primer gasto
            </a>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Descripción</th>
                            <th>Categoría</th>
                            <th>Tipo</th>
                            <th>Monto</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var gasto in Model)
                        {
                            var icono = iconos.GetValueOrDefault(gasto.Categoria?.Icono ?? "", "bi-tag");
                            var color = colores.GetValueOrDefault(gasto.Categoria?.Icono ?? "", "#b2bec3");
                            <tr>
                                <td style="color: #6b7280;">
                                    @gasto.Fecha.ToString("dd/MM/yyyy")
                                </td>
                                <td style="font-weight: 500;">@gasto.Descripcion</td>
                                <td>
                                    <span style="display: inline-flex; align-items: center; gap: 6px; background: @(color)18; color: @color; padding: 4px 10px; border-radius: 8px; font-size: 13px; font-weight: 500;">
                                        <i class="bi @icono"></i>
                                        @gasto.Categoria?.Nombre
                                    </span>
                                </td>
                                <td>
                                    @if (gasto.Tipo == "Ingreso")
                                    {
                                        <span class="badge bg-success">↑ Ingreso</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">↓ Gasto</span>
                                    }
                                </td>
                                <td style="font-weight: 600; @(gasto.Tipo == "Ingreso" ? "color: #00b894;" : "color: #e17055;")">
                                    @(gasto.Tipo == "Ingreso" ? "+" : "-")$@gasto.Monto.ToString("N2")
                                </td>
                                <td>
                                    <a asp-action="Editar" asp-route-id="@gasto.Id"
                                       class="btn btn-sm btn-outline-primary me-1">Editar</a>
                                    <a asp-action="Eliminar" asp-route-id="@gasto.Id"
                                       class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('¿Seguro que quieres eliminar este gasto?')">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
